# Required only for the serverless API (/api/session, /api/ask).
# Use a long random string, for example the output of: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
STITCH_SECRET=

# Optional: the Walnut stitches (python -m stitch_walnut). When set, every answer passes Walnut's
# grounding wall and every Crypt event is sealed in Walnut's durable ledger. Unreachable means 503.
STITCH_WALNUT_URL=
# Required by python -m stitch_walnut unless it runs with --ephemeral-key (at least 32 characters).
STITCH_WALNUT_KEY=
# Required with a durable Crypt, optional otherwise (at least 32 characters). Every stitches route except
# health then needs it. The API and the dev proxy send it from the server side; never put it in the page.
STITCH_WALNUT_CALLER_KEY=
# Optional: extra host names the stitches accept in Host and Origin, comma separated. Loopback is always allowed.
STITCH_WALNUT_ALLOW_HOSTS=
# Optional: when set, /api/session needs it in the x-stitch-session-key header. Unset is the open judging
# demo, where anyone can get a token for any persona and the response says demoIdentity: true.
STITCH_SESSION_KEY=
